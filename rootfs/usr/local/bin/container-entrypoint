#!/bin/sh
set -eu

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

case "${WEB_PORT}:${VNC_PORT}:${GEOMETRY}:${DEPTH}:${PUID}:${PGID}" in
  *[!0-9:x]*) echo "Invalid numeric/display configuration" >&2; exit 64 ;;
esac

if [ "$(id -u)" -eq 0 ]; then
  if [ "${PGID}" != "1000" ]; then delgroup zenmap 2>/dev/null || true; addgroup -g "${PGID}" zenmap; fi
  if [ "${PUID}" != "1000" ]; then deluser zenmap 2>/dev/null || true; adduser -D -u "${PUID}" -G zenmap -h /config zenmap; fi
  mkdir -p /config/scans /config/.vnc /tmp/runtime-zenmap /tmp/.X11-unix
  chmod 1777 /tmp/.X11-unix
  chown -R "${PUID}:${PGID}" /config /tmp/runtime-zenmap
  chmod 700 /tmp/runtime-zenmap
fi

export HOME=/config XDG_CONFIG_HOME=/config/.config XDG_DATA_HOME=/config/.local/share
export XDG_RUNTIME_DIR=/tmp/runtime-zenmap
export NMAP_PRIVILEGED="${NMAP_PRIVILEGED:-1}"

if [ -n "${VNC_PASSWORD:-}" ]; then
  if [ "${#VNC_PASSWORD}" -gt 8 ]; then
    echo "WARNING: Traditional VNC authentication uses only the first 8 password characters." >&2
  fi
  x11vnc -storepasswd "${VNC_PASSWORD}" /config/.vnc/passwd >/dev/null
  if [ "$(id -u)" -eq 0 ]; then
    chown "${PUID}:${PGID}" /config/.vnc/passwd
  fi
  chmod 600 /config/.vnc/passwd
  VNC_AUTH="-rfbauth /config/.vnc/passwd"
elif [ "${ALLOW_INSECURE_VNC:-0}" = "1" ]; then
  echo "WARNING: VNC authentication is disabled by ALLOW_INSECURE_VNC=1." >&2
  VNC_AUTH="-nopw"
else
  echo "VNC_PASSWORD must be set (or explicitly set ALLOW_INSECURE_VNC=1)." >&2
  exit 64
fi

run_user() {
  if [ "$(id -u)" -eq 0 ]; then su-exec "${PUID}:${PGID}" "$@"; else "$@"; fi
}

cleanup() { kill $(jobs -p) 2>/dev/null || true; }
trap cleanup INT TERM EXIT

run_user Xvfb "${DISPLAY}" -screen 0 "${GEOMETRY}x${DEPTH}" -nolisten tcp &
sleep 1
run_user dbus-launch --exit-with-session openbox-session &
# shellcheck disable=SC2086
run_user x11vnc -display "${DISPLAY}" -forever -shared -listen 127.0.0.1 \
  -rfbport "${VNC_PORT}" ${VNC_AUTH} &
run_user websockify --web /usr/share/novnc \
  "${WEB_PORT}" "127.0.0.1:${VNC_PORT}" &
sleep 1

# Closing Zenmap must not terminate the desktop, VNC server, or container.
# Relaunch it after a short delay so a disconnected browser can reconnect.
while :; do
  run_user zenmap || true
  sleep 2
done &

wait -n
